# Copy this file to .env. Never commit .env.
ENVIRONMENT=development
# Zero-setup local option. PostgreSQL is the deployment database.
DATABASE_URL=sqlite:///./streamdoctor.db
# For a local PostgreSQL server (URL-encode special characters in the password):
# DATABASE_URL=postgresql+psycopg://streamdoctor:YOUR_PASSWORD@localhost:5432/streamdoctor
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
SESSION_TTL_MINUTES=60
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
# Required only by Docker Compose; choose a unique password before running it.
POSTGRES_PASSWORD=

# Private photo storage; do not serve this directory as static content.
UPLOAD_DIR=storage/photos
MAX_PHOTO_BYTES=8388608
MAX_STORED_PHOTO_BYTES=33554432
MAX_PHOTO_PIXELS=16000000
MAX_PHOTOS_PER_REPORT=5

# Mock AI is only for synthetic reports.
AI_MODE=disabled
# In http mode, set the complete endpoint implemented by the AI teammate:
# AI_SERVICE_URL=http://127.0.0.1:9000/analyze
# AI_SERVICE_TOKEN=server-to-server-secret
AI_TIMEOUT_SECONDS=30
AI_MAX_RESPONSE_BYTES=65536
AI_RATE_LIMIT=6
